# Supabase project settings -> API keys.
# Legacy anon JWT keys also work in this slot.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Card payments (optional). Without these the app works but hides "Buy now".
# Supabase > Project Settings > API Keys > secret key. SERVER ONLY.
SUPABASE_SECRET_KEY=sb_secret_xxx
# Stripe > Developers > API keys (use sk_test_ while testing).
STRIPE_SECRET_KEY=sk_test_xxx
# Stripe > Developers > Webhooks > your endpoint > Signing secret.
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Country of your Stripe account (US, GB, AE...). Defaults to US.
STRIPE_PLATFORM_COUNTRY=US
